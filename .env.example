DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=expense_tracker
SECRET_KEY=generate_a_long_random_secret_key_here
FRONTEND_ORIGIN=http://127.0.0.1:8000

# Gmail SMTP — required for email verification and password reset
# 1. Enable 2-Step Verification on your Gmail account
# 2. Go to Google Account > Security > App Passwords
# 3. Generate an App Password for "Mail"
# 4. Paste the 16-character password below (spaces are OK)
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_DEFAULT_SENDER=EduFinance <your_gmail@gmail.com>

# Google OAuth 2.0 (optional — leave blank to disable)
# Setup at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret